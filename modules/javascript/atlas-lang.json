{
  "schemaVersion": 2,
  "name": "javascript",
  "version": "0.1.0",
  "extensions": [".js", ".cjs", ".mjs", ".jsx"],
  "grammar": {
    "wasm": "grammar.wasm",
    "lock": "grammar.lock"
  },
  "queries": {
    "tags": "queries/tags.scm",
    "refs": "queries/refs.scm",
    "imports": "queries/imports.scm"
  },
  "tiers": ["grammar"],
  "parseBudget": 0.005,
  "project": {
    "adrDirs": ["docs/adr", "docs/adrs", "doc/adr", "adr"]
  }
}
