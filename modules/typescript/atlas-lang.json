{
  "schemaVersion": 2,
  "name": "typescript",
  "version": "0.1.0",
  "extensions": [".ts", ".cts", ".mts"],
  "grammar": {
    "wasm": "grammar.wasm",
    "lock": "grammar.lock"
  },
  "queries": {
    "tags": "queries/tags.scm",
    "refs": "queries/refs.scm",
    "imports": "queries/imports.scm"
  },
  "tiers": ["grammar", "precise"],
  "parseBudget": 0.005,
  "project": {
    "markers": ["tsconfig.json"],
    "model": "typescript",
    "adrDirs": ["docs/adr", "docs/adrs", "doc/adr", "adr"]
  },
  "precise": {
    "adapter": "typescript"
  }
}
