          }
        },
        "replace": {
          "type": "boolean"
        },
        "grammar": {
          "type": "object",
          "properties": {
            "wasm": {
              "type": "string",
              "pattern": "^(?![A-Za-z]:)(?!\\/)(?!(?:[^/]*\\/)*\\.\\.(?:\\/|$))[^\\\\\\u0000]+$"
            },
            "lock": {
              "type": "string",
              "pattern": "^(?![A-Za-z]:)(?!\\/)(?!(?:[^/]*\\/)*\\.\\.(?:\\/|$))[^\\\\\\u0000]+$"
            }
          },
          "required": [
            "wasm",
            "lock"
          ],
          "additionalProperties": false
        },
        "queries": {
          "type": "object",
          "properties": {
            "tags": {
              "type": "string",
