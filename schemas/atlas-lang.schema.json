            },
            "imports": {
              "type": "string",
              "pattern": "^(?![A-Za-z]:)(?!\\/)(?!(?:[^/]*\\/)*\\.\\.(?:\\/|$))[^\\\\\\u0000]+$"
            }
          },
          "required": [
            "tags"
          ],
          "additionalProperties": false
        },
        "tiers": {
          "default": [
            "grammar"
          ],
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "grammar",
              "precise",
              "platform"
            ]
          }
        },
        "parseBudget": {
          "default": 0.005,
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "testGlobs": {
