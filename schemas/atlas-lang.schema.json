            {
              "type": "object",
              "properties": {
                "command": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "required": [
                "command"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "adapter": {
                  "type": "string",
                  "maxLength": 64,
                  "pattern": "^[a-z][a-z0-9-]*$"
                }
              },
              "required": [
                "adapter"
              ],
              "additionalProperties": false
            }
          ]
        },
        "project": {
          "type": "object",
          "properties": {
