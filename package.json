{
  "name": "@opengsd/gsd-atlas",
  "version": "0.0.0",
  "description": "A local map of a codebase and the platform SDKs it targets, built for coding agents.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.16.0"
  },
  "bin": {
    "gsd-atlas": "dist/bin/gsd-atlas.js",
    "gsd-atlas-mcp": "dist/bin/gsd-atlas-mcp.js"
  },
  "files": [
    "dist",
    "schemas",
    "modules"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "test": "node --test \"src/**/*.test.ts\" \"scripts/**/*.test.ts\"",
    "coverage": "c8 --reporter=text node --test \"src/**/*.test.ts\" \"scripts/**/*.test.ts\"",
    "schema:build": "node scripts/schema-build.ts",
    "schema:check": "node scripts/schema-build.ts --check",
    "grammar:build": "node scripts/grammar-build.ts",
    "grammar:verify": "node scripts/grammar-verify.ts",
    "grammar:budget": "node scripts/grammar-budget.ts",
    "recall": "node scripts/recall.ts",
    "recall:corpus": "node scripts/recall.ts --corpus gsd-core",
    "size-gate": "node scripts/size-gate.ts",
    "gates:corpus": "node scripts/corpus-gates.ts",
    "gates:freshness": "node scripts/freshness-gate.ts",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "@parcel/watcher": "2.6.0",
    "jsonc-parser": "3.3.1",
    "typescript": "6.0.3",
    "web-tree-sitter": "0.27.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "better-sqlite3": "13.0.3",
    "c8": "12.0.0",
    "eslint": "10.12.0",
    "tree-sitter-cli": "0.27.1",
    "typescript-7": "npm:typescript@7.0.2",
    "typescript-eslint": "8.71.2"
  },
  "peerDependencies": {
    "better-sqlite3": "13.0.3"
  },
  "peerDependenciesMeta": {
    "better-sqlite3": {
      "optional": true
    }
  },
  "allowScripts": {
    "tree-sitter-cli": true
  }
}
